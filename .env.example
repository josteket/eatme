# ==== Telegram ====
# Токен бота от @BotFather
BOT_TOKEN=123456:PUT_YOUR_TOKEN_HERE

# Публичный HTTPS-URL, на котором открывается Mini App.
# Для локальной разработки удобно прокинуть через туннель (cloudflared / ngrok).
# Пример: https://eatme.example.com  или  https://xxxx.trycloudflare.com
WEBAPP_URL=https://localhost

# Telegram ID тех, кому разрешён вход (муж и жена). Через запятую.
# Узнать свой ID можно у бота @userinfobot
ALLOWED_TELEGRAM_IDS=111111111,222222222

# Кто из ID — «жена» (беременная, ГСД+целиакия). Остальные разрешённые считаются «мужем».
WIFE_TELEGRAM_ID=111111111

# ==== Сервер ====
HOST=0.0.0.0
PORT=8080

# Секрет для подписи (можно любую длинную строку)
SECRET_KEY=change-me-to-a-long-random-string

# Путь к файлу базы (по умолчанию рядом с проектом)
DATABASE_URL=sqlite:///./eatme.db

# Режим разработки: если true — можно открыть Mini App в обычном браузере
# без Telegram (авторизация как первый разрешённый пользователь). В проде оставить false.
DEV_MODE=true
